# Hrdle environment variables
# Port / host / password are normally set via CLI flags (-p / -H / -P);
# env vars below are read by the backend at startup.

# Auth password (alternative to -P). This is the name `hrdle setup` writes into
# the systemd EnvironmentFile; CCHUB_PASSWORD is still read so an install from
# before the rename keeps working.
HRDLE_PASSWORD=

# JWT signing secret for session tokens.
# Optional — a random 32-byte secret is generated per process if unset
# (set it to keep logins valid across server restarts).
JWT_SECRET=

# Data directory (session metadata, peers.json). Default: ~/.hrdle
HRDLE_DATA_DIR=

# Static frontend root served by the backend. Default: ../frontend/dist
STATIC_ROOT=

# GitHub token for `hrdle update` (avoids API rate limits; falls back to gh CLI)
GH_TOKEN=
GITHUB_TOKEN=

# Set to 1 or true to enable [mux] WS viewport debug logs (/ws/mux)
DEBUG_MUX=

# herdr socket path. Default: ~/.config/herdr/herdr.sock
HERDR_SOCKET_PATH=

# Path to the herdr binary. Default: auto-detect (PATH, then ~/.local/bin etc.)
HERDR_BIN=

# Groq API key for the glasses' speech-to-text (POST /api/glasses/stt).
# Without it that endpoint answers 503; the key never leaves this host.
# A key saved from the glasses settings screen overrides this one.
GROQ_API_KEY=

# Vocabulary prompt for that transcription. `off` disables it; any other value
# replaces the composed prompt (for A/B testing). A prompt saved from the
# glasses settings screen overrides this one; the language lives there too.
HRDLE_STT_PROMPT=

# Experimental per-client (smallest-wins) pane sizing. Set to 1 to opt in
# (default: off; active-client sizing drives the session size instead)
CCHUB_PER_CLIENT_SIZING=
