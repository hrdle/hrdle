{
  "name": "backend",
  "version": "0.1.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bash ../scripts/dev-backend.sh",
    "dev:auth": "bash ../scripts/dev-backend.sh -P devpass",
    "build": "bun build src/index.ts --outdir dist --target bun",
    "start": "bun run dist/index.js",
    "test": "bun test",
    "lint": "bunx @biomejs/biome lint src/",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@hono/zod-validator": "^0.9",
    "@mmmike/web-push": "^0.1.0",
    "hono": "^4.12.33",
    "qrcode": "^1.5.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.18",
    "typescript": "^7"
  }
}
